cabal-version:      2.4
name:               surrealdb-memory
version:            0.1.0.0
synopsis:           Agent Memory client for Haskell
description:
  A Haskell client for SurrealDB's Agent Memory knowledge platform. It
  mirrors the official @\@surrealdb/memory@ JavaScript client and exposes the
  memory operations (remember, recall, context, reflect, forget) along with the
  chat loop and the documents, entities, sessions, lifecycle, traces,
  principals, scopes and keys namespaces.

license:            Apache-2.0
license-file:       ../LICENSE
author:             SurrealDB
maintainer:         hello@surrealdb.com
homepage:           https://github.com/surrealdb/surrealdb.haskell
category:           Database
build-type:         Simple
extra-source-files: ../README.md

common warnings
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates
               -Wincomplete-uni-patterns -Wredundant-constraints

library
  import:           warnings
  hs-source-dirs:   src
  default-language: Haskell2010
  exposed-modules:
    AgentMemory
    AgentMemory.Chat
    AgentMemory.Client
    AgentMemory.Error
    AgentMemory.Memory
    AgentMemory.Namespaces
    AgentMemory.Status
    AgentMemory.Types
  build-depends:
    , aeson              >=2.0   && <2.3
    , base               >=4.16  && <5
    , bytestring         >=0.11  && <0.13
    , containers         >=0.6   && <0.8
    , exceptions         >=0.10  && <0.11
    , http-client        >=0.7   && <0.8
    , http-client-tls    >=0.3   && <0.4
    , http-types         >=0.12  && <0.13
    , mtl                >=2.2   && <2.4
    , text               >=1.2   && <2.2
    , time               >=1.11  && <1.15
    , unordered-containers >=0.2 && <0.3

test-suite surrealdb-memory-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  default-language: Haskell2010
  other-modules:
    AgentMemory.CodecSpec
  build-depends:
    , aeson
    , base
    , bytestring
    , surrealdb-memory
    , tasty              >=1.4  && <1.6
    , tasty-hunit        >=0.10 && <0.11
    , text
