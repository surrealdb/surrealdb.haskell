cabal-version:      2.4
name:               surrealdb
version:            0.1.0.0
synopsis:           SurrealDB client for Haskell with CBOR and JSON-RPC support
description:
  A Haskell SDK for SurrealDB with feature parity to the official JavaScript
  SDK. It supports both the WebSocket and HTTP transports and speaks both the
  CBOR (default) and JSON-RPC wire codecs. The public API is exposed through a
  @MonadSurreal@ typeclass with a ReaderT based runner so it composes with any
  application monad stack.

license:            Apache-2.0
license-file:       ../LICENSE
author:             SurrealDB
maintainer:         hello@surrealdb.com
homepage:           https://github.com/surrealdb/surrealdb.haskell
category:           Database
build-type:         Simple
extra-source-files: ../README.md

common warnings
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates
               -Wincomplete-uni-patterns -Wredundant-constraints

library
  import:           warnings
  hs-source-dirs:   src
  default-language: Haskell2010
  exposed-modules:
    Database.Surreal
    Database.Surreal.Api
    Database.Surreal.Auth
    Database.Surreal.Class
    Database.Surreal.Codec
    Database.Surreal.Connection
    Database.Surreal.Engine
    Database.Surreal.Engine.Http
    Database.Surreal.Engine.WebSocket
    Database.Surreal.Error
    Database.Surreal.Live
    Database.Surreal.Monad
    Database.Surreal.RPC
    Database.Surreal.Transaction
    Database.Surreal.Types
    Database.Surreal.Value
  other-modules:
    Database.Surreal.Value.Cbor
    Database.Surreal.Value.Json
  build-depends:
    , aeson              >=2.0    && <2.3
    , async              >=2.2    && <2.3
    , base               >=4.16   && <5
    , base16-bytestring  >=1.0    && <1.1
    , bytestring         >=0.11   && <0.13
    , cborg              >=0.2    && <0.3
    , containers         >=0.6    && <0.8
    , exceptions         >=0.10   && <0.11
    , hashable           >=1.4    && <1.6
    , http-client        >=0.7    && <0.8
    , http-client-tls    >=0.3    && <0.4
    , http-types         >=0.12   && <0.13
    , mtl                >=2.2    && <2.4
    , network            >=3.1    && <3.3
    , network-uri        >=2.6    && <2.7
    , scientific         >=0.3    && <0.4
    , serialise          >=0.2    && <0.3
    , stm                >=2.5    && <2.6
    , text               >=1.2    && <2.2
    , time               >=1.11   && <1.15
    , transformers       >=0.5    && <0.7
    , unordered-containers >=0.2  && <0.3
    , uuid               >=1.3    && <1.4
    , uuid-types         >=1.0    && <1.1
    , vector             >=0.12   && <0.14
    , websockets         >=0.12   && <0.14
    , wuss               >=2.0    && <2.1

test-suite surrealdb-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  default-language: Haskell2010
  other-modules:
    Test.Surreal.Harness
    Test.Surreal.Gen
    Test.Surreal.CodecSpec
    Test.Surreal.ValueSpec
    Test.Surreal.RpcSpec
    Test.Surreal.IntegrationSpec
  build-depends:
    , aeson
    , async
    , base
    , bytestring
    , containers
    , directory          >=1.3 && <1.4
    , http-client        >=0.7 && <0.8
    , network            >=3.1 && <3.3
    , process            >=1.6 && <1.7
    , scientific
    , serialise
    , surrealdb
    , tasty              >=1.4 && <1.6
    , tasty-hunit        >=0.10 && <0.11
    , tasty-quickcheck   >=0.10 && <0.11
    , QuickCheck         >=2.14 && <2.16
    , text
    , time
    , unordered-containers
    , uuid
    , uuid-types
    , vector
